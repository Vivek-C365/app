# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# External Services (Keep existing)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-preset

# Firebase (for push notifications)
EXPO_PUBLIC_FCM_SERVER_KEY=your-fcm-key

# API Keys for Edge Functions (set via supabase secrets)
# These should NOT be in the mobile app .env
# BREVO_API_KEY=your-brevo-key
# WHATSAPP_API_KEY=your-whatsapp-key
# GEMINI_API_KEY=your-gemini-key
